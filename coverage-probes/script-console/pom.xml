<?xml version="1.0" encoding="UTF-8"?>
<!--
  Analyzer coverage probe for AemRuntimeRisk:ScriptConsoleDeployed. Not a reactor module and never built:
  it only shows a script console embedded into an install folder that also applies to publish.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.adobe.aem.guides</groupId>
    <artifactId>aem-guides-wknd.coverage-probe.script-console</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>content-package</packaging>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <embeddeds>
                        <embedded>
                            <groupId>be.orbinson.aem</groupId>
                            <artifactId>aem-groovy-console-all</artifactId>
                            <type>zip</type>
                            <target>/apps/wknd-vendor-packages/application/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
