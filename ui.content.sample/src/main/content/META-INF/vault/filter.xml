<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">

    <!-- Content Filters -->
    <!-- FM pipeline smoketest: merge mode so this package never deletes pre-existing
         content on a target environment (needed to be safe against real customer tenants) -->
    <filter root="/content/wknd" mode="merge"/>
    <filter root="/content/dam/wknd" mode="update"/>
    <filter root="/content/experience-fragments/wknd" mode="merge"/>

    <!-- Force Policy and Template Updates -->
    <filter root="/conf/wknd/settings/wcm" />
    <filter root="/conf/wknd/settings/cloudconfigs" mode="merge" />
    <filter root="/conf/wknd/settings/cloudsettings" mode="merge" />

    <!-- WKND Member Group-->
    <filter root="/home/groups/wknd" mode="merge" />
    <!-- Sample User-->
    <filter root="/home/users/wknd" mode="merge" />
</workspaceFilter>
