<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:oak="http://jackrabbit.apache.org/oak/ns/1.0"
    jcr:primaryType="nt:unstructured">
    <wkndCoverageProbeProperty
        jcr:primaryType="oak:QueryIndexDefinition"
        type="property"
        propertyNames="[wkndCoverageProbe]"/>
    <wkndCoverageProbeLucene
        jcr:primaryType="oak:QueryIndexDefinition"
        type="lucene"
        compatVersion="{Long}2"
        includedPaths="[/content/wknd]">
        <indexRules jcr:primaryType="nt:unstructured">
            <nt:base jcr:primaryType="nt:unstructured">
                <properties jcr:primaryType="nt:unstructured">
                    <wkndCoverageProbe
                        jcr:primaryType="nt:unstructured"
                        name="wkndCoverageProbe"
                        propertyIndex="{Boolean}true"/>
                </properties>
            </nt:base>
        </indexRules>
    </wkndCoverageProbeLucene>
</jcr:root>
